; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Truth Detective • Stillwater Corner"
config/description="A compact, atmospheric, fixed-camera neighborhood. Playable detective vertical slice."
run/main_scene="res://scenes/playable_neighborhood.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[autoload]

CaseState="*res://scripts/case_state.gd"

[environment]

defaults/default_clear_color=Color(0.035, 0.052, 0.063, 1)

[rendering]

anti_aliasing/quality/msaa_3d=2
